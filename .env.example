# Copy to .env for local dev (.env is gitignored). Never commit real values.
# For EAS builds set these as EAS environment variables per profile (preview / production), not in eas.json.
EXPO_PUBLIC_SHOPIFY_DOMAIN=barakatoptical.com.sa
# Storefront API public read-only token (scopes: unauthenticated_read_*, unauthenticated_write/read_checkouts).
# Shipped inside the app bundle by design; still rotate it if leaked. Create in Shopify admin > Develop apps.
EXPO_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
